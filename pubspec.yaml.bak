name: llano_music_app
description: La aplicación del auténtico sonido del Llano

publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ">=3.8.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ^1.0.8
  audioplayers: ^6.1.0

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true

  assets:
      - assets/images/logo/logo_llano_music.png

      # Audios principales
      - assets/audio/

      # Audios clásicos
      - assets/audio/clasicos/luis_lozada/
      - assets/audio/clasicos/julio_miranda/
      - assets/audio/clasicos/freddy_salcedo/
      - assets/audio/clasicos/sexagesimo/
      - assets/audio/clasicos/nelson_morales/
      - assets/audio/clasicos/cristobal_jimenez/
      - assets/audio/clasicos/damaso_figueredo/
      - assets/audio/clasicos/jose_ali_nieves/
      - assets/audio/clasicos/julio_pantoja/
      - assets/audio/clasicos/jose_jimenez/
      - assets/audio/clasicos/humberto_salas/
      - assets/audio/clasicos/jesus_quintero/
      - assets/audio/clasicos/ramon_blanco/
      - assets/audio/clasicos/rafael_alvarado/

      # Banners
      - assets/banners/

      # Imágenes
      - assets/images/artistas/
      - assets/images/clasicos/
      - assets/images/logo/
      - assets/images/icons/
